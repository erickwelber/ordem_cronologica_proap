	column Dias_Tramitacao =
			
			VAR DataFim = COALESCE('fato_ordem_cronologica'[compromisso_dia_pagamento], TODAY())
			RETURN
			DATEDIFF('fato_ordem_cronologica'[dh_dia_ateste], DataFim, DAY)
		formatString: 0
		lineageTag: 9e33543d-a8e6-40f3-9727-f892f2c0f100
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Situacao_Prazo =
			
			SWITCH(
			    TRUE(),
			    'fato_ordem_cronologica'[Dias_Tramitacao] <= 30, "NO PRAZO (até 30 dias)",
			    'fato_ordem_cronologica'[Dias_Tramitacao] <= 60, "ATENÇÃO (31 a 60 dias)",
			    'fato_ordem_cronologica'[Dias_Tramitacao] > 60, "CRÍTICO (mais de 60 dias)",
			    "Não informado"
			)
		lineageTag: a960ba8a-c12b-4e16-a4f9-b30edc8a32dd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ordem_Situacao =
			
			SWITCH(
			    TRUE(),
			    'fato_ordem_cronologica'[Dias_Tramitacao] <= 30, 1,
			    'fato_ordem_cronologica'[Dias_Tramitacao] <= 60, 2,
			    'fato_ordem_cronologica'[Dias_Tramitacao] > 60, 3,
			    4
			)
		formatString: 0
		lineageTag: ffac5af0-6ef9-48e1-8520-32bf2d7f45f6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Dias_Pagamento = ```
			
			DATEDIFF(
			    fato_ordem_cronologica[dh_dia_ateste], 
			    fato_ordem_cronologica[compromisso_dia_pagamento], 
			    DAY
			)
			```
		formatString: 0
		lineageTag: 777f45ca-d820-4ab3-801c-68d9ce2f654c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '-- Faixa_Intervalo' =
			
			VAR Dias = DATEDIFF(fato_ordem_cronologica[dh_dia_ateste], fato_ordem_cronologica[compromisso_dia_pagamento], DAY)
			RETURN
			SWITCH(
			    TRUE(),
			    Dias <= 5, "0 a 5 dias",
			    Dias <= 30, "6 a 30 dias",
			    Dias <= 40, "31 a 40 dias",
			    Dias <= 50, "41 a 50 dias",
			    Dias <= 60, "51 a 60 dias",
			    Dias <= 70, "61 a 70 dias",
			    Dias <= 80, "71 a 80 dias",
			    Dias <= 90, "81 a 90 dias",
			    Dias <= 180, "91 a 180 dias",
			    Dias <= 365, "181 a 365 dias",
			    "> 365 dias"
			)
		lineageTag: a7acbd32-d776-43b6-833f-3f244f42760f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ordem_Mes_Pgto = FORMAT(fato_ordem_cronologica[compromisso_dia_pagamento], "YYYYMM")
		lineageTag: 684f1198-4365-4e07-bfec-e29631afb267
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Mes_Ano_Pgto = UPPER(FORMAT(fato_ordem_cronologica[compromisso_dia_pagamento], "MMM YYYY"))
		lineageTag: e641dd07-a7fc-49df-b8b3-67cbee7306a4
		summarizeBy: none
		sortByColumn: Ordem_Mes_Pgto

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

